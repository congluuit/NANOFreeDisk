{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/congluuit/NANOFreeDisk/blob/main/docs/schema/dupes-v1.schema.json",
  "title": "NANOFreeDisk duplicates report (nanofreedisk.dupes.v1)",
  "description": "Output of `nfd dupes --json`. Sizes in bytes, times in Unix seconds (UTC), paths absolute. Volume serials and file ids are hex text (they may not fit a JSON number). Adding fields is backward compatible; renaming or removing one bumps the schema id.",
  "type": "object",
  "required": [
    "schema", "version", "roots", "minSize", "groups", "wastedBytes", "scannedFiles",
    "candidates", "hashedBytes", "cacheHits", "skipped", "skippedSamples", "elapsedMs", "paranoid"
  ],
  "properties": {
    "schema": { "const": "nanofreedisk.dupes.v1" },
    "version": { "type": "string", "description": "nfd version that wrote the report" },
    "roots": { "type": "array", "items": { "type": "string" }, "description": "Folders searched" },
    "minSize": { "$ref": "#/$defs/count", "description": "Smaller files were left out" },
    "paranoid": { "type": "boolean", "description": "Groups were also compared byte by byte" },
    "wastedBytes": { "$ref": "#/$defs/count", "description": "Sum of the groups' wasted bytes" },
    "scannedFiles": { "$ref": "#/$defs/count" },
    "candidates": { "$ref": "#/$defs/count", "description": "Files sharing their size with another one" },
    "hashedBytes": { "$ref": "#/$defs/count", "description": "Bytes read from disk in this run" },
    "cacheHits": { "$ref": "#/$defs/count", "description": "Files whose hashes came from the cache" },
    "elapsedMs": { "$ref": "#/$defs/count" },
    "skipped": {
      "type": "object",
      "description": "Files left out, by reason",
      "propertyNames": { "$ref": "#/$defs/reason" },
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "skippedSamples": {
      "type": "array",
      "description": "A few examples (empty and small files are never listed)",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Sets of byte-identical files, largest waste first",
      "items": {
        "type": "object",
        "required": ["id", "hash", "size", "wasted", "copies"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "BLAKE3 of the contents" },
          "size": { "$ref": "#/$defs/count", "description": "Size of each copy" },
          "wasted": { "$ref": "#/$defs/count", "description": "size × (copies − 1)" },
          "copies": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["path", "mtime", "volume", "fileId", "flags"],
              "properties": {
                "path": { "type": "string" },
                "mtime": { "type": "integer" },
                "volume": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
                "fileId": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
                "links": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Other names of the same file (hard links), never counted as copies"
                },
                "flags": {
                  "type": "object",
                  "required": ["cloud", "git", "appDir", "readonly"],
                  "properties": {
                    "cloud": { "type": "boolean", "description": "Inside a cloud-sync folder" },
                    "git": { "type": "boolean", "description": "Inside a git working tree" },
                    "appDir": { "type": "boolean", "description": "Inside an application folder" },
                    "readonly": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "reason": {
      "enum": [
        "empty", "small", "extension", "cloud", "reparse", "system", "protected",
        "app-dir", "unreadable", "changed"
      ]
    }
  }
}
