# Startup view: programs that start with Windows, turned on or off the way
# Task Manager does (docs/STARTUP.md).

nav-startup = Startup
su-title = Startup apps
su-intro = Programs that start when you sign in to Windows. Turning one off keeps it installed: it just stops starting by itself, exactly like Task Manager's Startup apps page.
su-safety-note = Nothing is deleted. Turning an entry off only sets Task Manager's flag, so Undo or Task Manager turns it back on.
su-task-manager = Open Task Manager
su-task-manager-hint = Open Task Manager on its Startup apps page. Entries for all users are changed there, with administrator rights.
su-undo = Undo
su-undo-disabled = { $name } will no longer start with Windows.
su-undo-enabled = { $name } will start with Windows again.
su-search = Search startup apps
su-filter = Show
su-filter-all = All entries
su-filter-enabled = Enabled
su-filter-disabled = Disabled
su-filter-user = Only for me
su-filter-machine = All users
su-sort = Sort
su-sort-name = By name
su-sort-status = Enabled first
su-refresh = Refresh
su-refresh-hint = Read the startup entries again.
su-summary = { $count } startup entries, { $on } enabled · { $shown } shown
su-loading = Reading the startup entries…
su-none = No startup entry matches.
su-publisher-signed = Publisher from the program's digital signature.
su-publisher-unsigned = The program is not signed: this name comes from the file itself and is not verified.
su-origin-user-run = Registry, this user
su-origin-machine-run = Registry, all users
su-origin-machine-run32 = Registry, all users (32-bit)
su-origin-user-folder = Startup folder, this user
su-origin-common-folder = Startup folder, all users
su-machine = All users
su-machine-hint = Starts for every user of this PC. Changing it needs administrator rights.
su-caution-windows = Part of Windows
su-caution-windows-hint = The program lives in the Windows folder. Turning it off can change how Windows behaves.
su-caution-security = Security software
su-caution-security-hint = Antivirus or Windows Security. Turning it off at startup can leave the PC less protected.
su-missing = Program missing
su-missing-hint = The program this entry starts is no longer on the disk, so the entry does nothing at startup.
su-state-on = Enabled
su-state-off = Disabled
su-disable = Turn off
su-disable-hint = Stop it from starting with Windows. The program stays installed and Undo turns it back on.
su-enable = Turn on
su-enable-hint = Let it start with Windows again.
su-needs-admin = Needs administrator rights, change it in Task Manager
su-out-of-scope = Scheduled tasks and services can also start programs. They are not listed here: see Task Scheduler and Services.
su-confirm-title = Turn off { $name }?
su-confirm-windows = This entry belongs to Windows. Turning it off can change how Windows behaves, for example tray icons, typing or sync. You can turn it back on at any time.
su-confirm-security = This is security software. If it does not start with Windows, the PC can stay less protected until you start it yourself. You can turn it back on at any time.
su-enabled = { $name } will start with Windows.
su-disabled = { $name } will no longer start with Windows.
su-needs-admin-error = { $name } starts for all users: change it in Task Manager.
su-gone = { $name } is no longer a startup entry. The list was read again.
