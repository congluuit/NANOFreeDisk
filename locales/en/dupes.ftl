# Duplicates view (Phase 5, docs/PHASE5_DUPLICATES.md). Loaded together with app.ftl
# and clean.ftl; every key must exist in vi/dupes.ftl too.

dupes-title = Duplicates
dupes-intro = Files with exactly the same contents. One copy of each group always stays.
dupes-scope = Where to look
dupes-scope-current = The scan in Analyze
dupes-scope-current-none = Analyze a drive or folder first, or pick folders here.
dupes-scope-folders = These folders and drives
dupes-add-folder = Add folder…
dupes-pick-folder = Folder to search for duplicates
dupes-remove-folder = Remove this folder from the search
dupes-min-size = Files from
dupes-min-size-hint = If you change this: smaller files are left out of the next search. Empty files never count as duplicates.
dupes-kind = File type
dupes-kind-all = All files
dupes-kind-images = Photos and images
dupes-kind-videos = Videos
dupes-kind-music = Music
dupes-kind-documents = Documents
dupes-kind-archives = Archives and disk images
dupes-app-dirs = Include application folders
dupes-app-dirs-hint = Also list copies inside node_modules, .git, Steam libraries, %LOCALAPPDATA%\Programs… They are shown, never selected: apps need their files complete.
dupes-paranoid = Compare byte by byte
dupes-paranoid-hint = After the hashes, compare every group byte by byte (slower; the hashes alone have never mixed up two different files).
dupes-find = Find duplicates
dupes-find-hint = If you press this: the folders are read (sizes first, then only the files that could match), nothing is changed. Online-only cloud files are never downloaded.
dupes-phase-scan = Listing files… { $files } so far
dupes-phase-collect = Looking for files of the same size…
dupes-phase-partial = Sampling files of the same size: { $done } of { $total }
dupes-phase-full = Reading candidates in full: { $done } of { $total }
dupes-phase-compare = Comparing byte by byte: { $done } of { $total }
dupes-cancelled = Duplicate search cancelled.
dupes-summary = { $groups } groups of identical files, { $size } could be freed
dupes-stats = { $files } files looked at, { $read } read, { $cached } answered from the cache, { $seconds } s.
dupes-capped = the list shows the { $count } largest
dupes-not-compared = Not compared: { $count } files
dupes-skip-empty = Empty files
dupes-skip-empty-why = An empty file holds nothing, so removing it frees no space.
dupes-skip-small = Too small
dupes-skip-small-why = Smaller than { $size }: small files free little space and take long to compare.
dupes-skip-extension = Other file types
dupes-skip-extension-why = Not of the file type chosen in Options.
dupes-skip-cloud = Online-only cloud files
dupes-skip-cloud-why = Stored only in the cloud: reading them would download them, so they are never opened.
dupes-skip-reparse = Links and special files
dupes-skip-reparse-why = Shortcuts and links point to other files. The files they point to are compared where they really are.
dupes-skip-system = System files
dupes-skip-system-why = Marked as system files by the operating system, which needs them where they are.
dupes-skip-protected = Protected locations
dupes-skip-protected-why = In places the app never touches, such as Windows, Program Files, saved credentials and AI conversation history.
dupes-skip-app-dir = Application folders
dupes-skip-app-dir-why = Inside folders like node_modules, .git or game libraries: apps need every file there complete, even repeated ones.
dupes-skip-unreadable = Could not be read
dupes-skip-unreadable-why = Locked by another program, or your account may not read them.
dupes-skip-changed = Changed while being read
dupes-skip-changed-why = They changed during the search, so the result would not be reliable. Search again when nothing is writing to them.
dupes-skip-clone = APFS clones
dupes-skip-clone-why = These copies already share their data on the disk: removing one frees nothing.
dupes-skip-act-lower = Include files from { $size }
dupes-skip-act-lower-hint = If you press this: the search runs again and also compares smaller files. It takes longer, nothing is changed.
dupes-skip-act-app-dirs = Show application folders
dupes-skip-act-app-dirs-hint = If you press this: the search runs again and also lists copies inside application folders. They are shown, never ticked.
dupes-skip-act-all-types = Search all file types
dupes-skip-act-all-types-hint = If you press this: the search runs again with every file type.
dupes-skip-act-again = Search again
dupes-skip-act-again-hint = If you press this: the same search runs again, nothing is changed.
dupes-start-title = Find copies of the same file in your folders
dupes-start-body = Looks through Documents, Downloads, Pictures, Videos, Music and Desktop for files with exactly the same contents. Nothing changes until you choose what to remove and confirm.
dupes-find-mine = Find duplicates in my files
dupes-find-mine-again = Search my files again
dupes-find-mine-hint = If you press this: Documents, Downloads, Pictures, Videos, Music and Desktop are read, nothing is changed. Online-only cloud files are never downloaded.
dupes-choose = Choose folders or drives
dupes-choose-hint = If you press this: the search options open so you can pick the folders or drives to look through.
dupes-options = Options
dupes-scope-personal = My personal folders
dupes-scope-personal-hint = Documents, Downloads, Pictures, Videos, Music and Desktop, wherever Windows or macOS keeps them (also when moved to OneDrive or another drive).
dupes-min-size-unit = Unit of the size limit
dupes-headline = You can free { $size } by removing { $count ->
    [one] one extra copy
   *[other] { $count } extra copies
}
dupes-headline-none = No two files with the same contents were found.
dupes-searched-in = Searched in: { $folders }
dupes-preselect-auto = Each group keeps the copy outside Downloads, Desktop and Temp (the oldest one, usually the original) and ticks the others, never copies in cloud-sync, git or application folders.
dupes-preselect-oldest = Each group keeps its oldest copy, usually the original, and ticks the others, never copies in cloud-sync, git or application folders.
dupes-preselect-newest = Each group keeps its newest copy and ticks the others, never copies in cloud-sync, git or application folders.
dupes-preselect-shortest = Each group keeps the copy with the shortest path and ticks the others, never copies in cloud-sync, git or application folders.
dupes-keeps = keeps the copy in { $folder }
dupes-keep = Keep
dupes-keep-hint = If you change this: every group picks again which copy stays. Copies in cloud-sync folders, git projects, application folders and read-only files are kept first and never selected.
dupes-keep-auto = Best guess (outside Downloads, the oldest)
dupes-keep-oldest = The oldest copy
dupes-keep-newest = The newest copy
dupes-keep-shortest = The shortest path
dupes-export = Export the duplicate list
dupes-copies = { $count } copies × { $size }
dupes-group-selected = { $count } to remove
dupes-keep-this = Keep
dupes-keep-this-hint = If you choose this: this copy stays and is never removed.
dupes-is-keeper = This copy stays.
dupes-remove = Remove
dupes-remove-hint = If you tick this: this copy is removed when you confirm; the copy marked Keep stays.
dupes-links = { $count } more names (hard links)
dupes-flag-cloud = cloud-sync
dupes-flag-cloud-hint = In a OneDrive / Dropbox / Google Drive folder: removing it here removes it in the cloud and on your other PCs.
dupes-flag-git = git
dupes-flag-git-hint = Inside a git project: it may be a tracked file.
dupes-flag-app = app
dupes-flag-app-hint = Inside an application folder: the app may need this copy.
dupes-flag-readonly = read-only
dupes-flag-readonly-hint = Marked read-only, usually on purpose.
dupes-flag-clone = APFS clone
dupes-flag-clone-hint = Shares its data with another copy (a Finder Duplicate or cp -c clone): removing it frees little or no space.
dupes-none = No duplicates found with these settings.
dupes-start = Choose where to look and press Find duplicates.
dupes-more = Show more ({ $count } groups left)
dupes-recycle-hint = If you press this: you see the list and confirm first; the selected copies then go to the Recycle Bin and one copy of each group stays.
dupes-quarantine = Quarantine
dupes-quarantine-hint = If you press this (Expert): the selected copies go to the quarantine instead of the Recycle Bin. It is faster for many files and restorable for 7 days.
dupes-confirm-recycle = Move duplicates to the Recycle Bin?
dupes-confirm-quarantine = Remove these duplicates?
dupes-confirm-body = { $files } copies in { $groups } groups, { $size }. One copy of every group stays.
dupes-confirm-note = Each copy and the copy that stays are read again right before the move; anything that changed is skipped.
dupes-confirm-risky = { $count } selected copies need a second look:
dupes-confirm-ack = I understand, remove them anyway
dupes-go-recycle = Move to Recycle Bin
dupes-go-quarantine = Remove
action-find-dupes = Find duplicates here
action-find-dupes-hint = Opens Duplicates and searches this folder (read-only).
activity-kind-dupes = Duplicates removed
reason-keeper-changed = The copy that stays changed or is gone, so this group was left alone.
reason-copy-changed = This copy changed since the search.
reason-not-a-duplicate = Not part of the duplicate search.
health-duplicates = { $size } in duplicate files ({ $value } groups) in { $folder }.
health-fix-duplicates = See duplicates
shell-menu-dupes-caption = Find duplicates here
dupes-link = Replace with links
dupes-link-hint = If you press this: you see what happens and confirm first; each selected copy on the same drive as the copy kept is then replaced by a link to it (block clone on ReFS / Dev Drive, hard link on NTFS) and the original waits 7 days in the quarantine.
dupes-confirm-link = Replace duplicates with links?
dupes-go-link = Replace with links
dupes-link-body = { $files } copies ({ $size }) will become links to the copy that stays; their paths keep working.
dupes-link-hardlink-note = Hard links: the paths then share one content. An app that edits one of them in place changes all of them, and attributes, permissions and dates are shared too. Only photos, videos, music, installers, disk images, archives and AI models are linked unless you tick other types below.
dupes-link-clone-note = Block clones (ReFS / Dev Drive) share storage but stay independent files: editing one never changes the other.
dupes-link-skipped = { $count } selected copies stay as they are: on another drive, on a drive without links, in a cloud-sync, git or application folder.
dupes-link-other-types = Also link other file types (documents, code…)
dupes-link-other-types-hint = If you tick this: selected files of any type are hard-linked, even ones apps usually edit in place.
dupes-link-undo = The originals stay in the quarantine for 7 days: Restore in Cleanup history puts them back and removes the links.
activity-mode-hardlink = replaced by a hard link
activity-mode-clone = replaced by a block clone
reason-no-keeper = No copy to link to.
reason-no-quarantine = This drive has no quarantine, so the copy was not replaced.
dupes-folders = Duplicate folders too
dupes-folders-hint = If you tick this: the next search also finds folders whose whole contents are identical (every file is read then, so it takes longer).
dupes-tab-files = Files ({ $count })
dupes-tab-folders = Folders ({ $count })
dupes-folder-copies = { $count } folders × { $files } files, { $size }
dupes-folders-none = No duplicate folders found.
dupes-folders-off = Tick "Duplicate folders too" and search again to compare folders.
dupes-folder-protected = This folder itself is protected: it can stay, never be removed.
dupes-flag-protected = protected
dupes-confirm-folders-body = { $folders } whole folders ({ $files } files, { $size }). One folder of every group stays.
dupes-confirm-folders-note = Each folder and the folder that stays are read again right before the move; a folder whose contents changed is skipped.
