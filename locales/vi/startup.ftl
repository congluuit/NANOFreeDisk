# Màn hình Khởi động: các chương trình chạy cùng Windows, bật hoặc tắt theo
# cách Task Manager làm (docs/STARTUP.md).

nav-startup = Khởi động
su-title = Ứng dụng khởi động
su-intro = Các chương trình tự chạy khi bạn đăng nhập Windows. Tắt một mục không gỡ chương trình: nó chỉ thôi tự chạy, đúng như trang Ứng dụng khởi động của Task Manager.
su-safety-note = Không xóa gì cả. Tắt một mục chỉ đặt cờ của Task Manager, nên Hoàn tác hoặc Task Manager bật lại được.
su-task-manager = Mở Task Manager
su-task-manager-hint = Mở Task Manager ở trang Ứng dụng khởi động. Các mục dành cho mọi người dùng được thay đổi ở đó, với quyền quản trị.
su-undo = Hoàn tác
su-undo-disabled = { $name } sẽ không tự chạy cùng Windows nữa.
su-undo-enabled = { $name } sẽ lại tự chạy cùng Windows.
su-search = Tìm ứng dụng khởi động
su-filter = Hiển thị
su-filter-all = Tất cả các mục
su-filter-enabled = Đang bật
su-filter-disabled = Đang tắt
su-filter-user = Chỉ của tôi
su-filter-machine = Mọi người dùng
su-sort = Sắp xếp
su-sort-name = Theo tên
su-sort-status = Mục đang bật trước
su-refresh = Làm mới
su-refresh-hint = Đọc lại danh sách mục khởi động.
su-summary = { $count } mục khởi động, { $on } đang bật · đang hiện { $shown }
su-loading = Đang đọc các mục khởi động…
su-none = Không có mục khởi động nào khớp.
su-publisher-signed = Nhà phát hành lấy từ chữ ký số của chương trình.
su-publisher-unsigned = Chương trình không có chữ ký số: tên này lấy từ chính tệp và chưa được xác minh.
su-origin-user-run = Registry, người dùng này
su-origin-machine-run = Registry, mọi người dùng
su-origin-machine-run32 = Registry, mọi người dùng (32-bit)
su-origin-user-folder = Thư mục Startup, người dùng này
su-origin-common-folder = Thư mục Startup, mọi người dùng
su-machine = Mọi người dùng
su-machine-hint = Chạy cho mọi người dùng của máy này. Muốn thay đổi cần quyền quản trị.
su-caution-windows = Thuộc Windows
su-caution-windows-hint = Chương trình nằm trong thư mục Windows. Tắt nó có thể làm Windows hoạt động khác đi.
su-caution-security = Phần mềm bảo mật
su-caution-security-hint = Phần mềm diệt virus hoặc Bảo mật Windows. Không cho nó chạy khi khởi động có thể khiến máy kém an toàn hơn.
su-missing = Thiếu chương trình
su-missing-hint = Chương trình mà mục này khởi chạy không còn trên ổ đĩa, nên mục này không làm gì khi khởi động.
su-state-on = Đang bật
su-state-off = Đang tắt
su-disable = Tắt
su-disable-hint = Không cho nó tự chạy cùng Windows. Chương trình vẫn được giữ nguyên và Hoàn tác sẽ bật lại.
su-enable = Bật
su-enable-hint = Cho nó tự chạy cùng Windows trở lại.
su-needs-admin = Cần quyền quản trị, hãy thay đổi trong Task Manager
su-out-of-scope = Tác vụ theo lịch và dịch vụ cũng có thể khởi chạy chương trình. Chúng không có ở đây: xem trong Task Scheduler và Services.
su-confirm-title = Tắt { $name }?
su-confirm-windows = Mục này thuộc Windows. Tắt nó có thể làm Windows hoạt động khác đi, ví dụ biểu tượng ở khay hệ thống, gõ phím hoặc đồng bộ. Bạn có thể bật lại bất cứ lúc nào.
su-confirm-security = Đây là phần mềm bảo mật. Nếu nó không chạy cùng Windows, máy có thể kém an toàn hơn cho đến khi bạn tự mở nó. Bạn có thể bật lại bất cứ lúc nào.
su-enabled = { $name } sẽ tự chạy cùng Windows.
su-disabled = { $name } sẽ không tự chạy cùng Windows nữa.
su-needs-admin-error = { $name } chạy cho mọi người dùng: hãy thay đổi trong Task Manager.
su-gone = { $name } không còn là mục khởi động. Danh sách đã được đọc lại.
