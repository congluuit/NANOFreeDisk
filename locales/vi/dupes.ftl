# Màn hình Tệp trùng (Phase 5, docs/PHASE5_DUPLICATES.md). Nạp cùng app.ftl và
# clean.ftl; mọi khóa phải có trong en/dupes.ftl.

dupes-title = Tệp trùng
dupes-intro = Các tệp có nội dung giống hệt nhau, nhóm lãng phí nhiều nhất trước. Mỗi nhóm luôn giữ lại một bản; mọi bản bạn xóa và bản được giữ đều được đọc lại từng byte ngay trước khi chuyển đi. Bản bị xóa vào Thùng rác (hoặc khu cách ly ở chế độ Chuyên gia) — khôi phục trong Hoạt động.
dupes-scope = Tìm ở đâu
dupes-scope-current = Lần quét trong Phân tích
dupes-scope-current-none = Hãy phân tích một ổ hay thư mục trước, hoặc chọn thư mục ở đây.
dupes-scope-folders = Các thư mục và ổ này
