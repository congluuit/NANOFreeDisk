dupes-skip-small = Quá nhỏ
dupes-skip-small-why = Nhỏ hơn { $size }: tệp nhỏ giải phóng được ít dung lượng mà so sánh lại lâu.
dupes-skip-extension = Loại tệp khác
dupes-skip-extension-why = Không thuộc loại tệp đã chọn trong Tùy chọn.
dupes-skip-cloud = Tệp đám mây chỉ trực tuyến
dupes-skip-cloud-why = Chỉ nằm trên đám mây: đọc chúng sẽ kéo tệp về máy, nên chúng không bao giờ được mở.
dupes-skip-reparse = Liên kết và tệp đặc biệt
dupes-skip-reparse-why = Lối tắt và liên kết trỏ tới tệp khác. Tệp được trỏ tới được so sánh ở đúng nơi của nó.
dupes-skip-system = Tệp hệ thống
dupes-skip-system-why = Được hệ điều hành đánh dấu là tệp hệ thống và cần nằm nguyên chỗ.
dupes-skip-protected = Vị trí được bảo vệ
dupes-skip-protected-why = Nằm ở nơi ứng dụng không bao giờ động tới, như Windows, Program Files, thông tin đăng nhập đã lưu và lịch sử hội thoại AI.
dupes-skip-app-dir = Thư mục ứng dụng
dupes-skip-app-dir-why = Nằm trong các thư mục như node_modules, .git hay thư viện game: ứng dụng cần đủ mọi tệp ở đó, kể cả tệp lặp lại.
dupes-skip-unreadable = Không đọc được
dupes-skip-unreadable-why = Đang bị chương trình khác khóa, hoặc tài khoản của bạn không có quyền đọc.
dupes-skip-changed = Thay đổi trong lúc đọc
dupes-skip-changed-why = Các tệp này đã thay đổi trong lúc tìm nên kết quả không đáng tin. Hãy tìm lại khi không có gì đang ghi vào chúng.
dupes-skip-clone = Bản sao APFS
dupes-skip-clone-why = Các bản này đã dùng chung dữ liệu trên ổ: xóa một bản không giải phóng được gì.
dupes-skip-act-lower = Gồm cả tệp từ { $size }
dupes-skip-act-lower-hint = Nếu bấm: lần tìm chạy lại và so sánh cả tệp nhỏ hơn. Sẽ lâu hơn, không thay đổi gì.
dupes-skip-act-app-dirs = Hiện thư mục ứng dụng
dupes-skip-act-app-dirs-hint = Nếu bấm: lần tìm chạy lại và liệt kê cả bản trong thư mục ứng dụng. Chỉ để xem, không bao giờ được tích sẵn.
dupes-skip-act-all-types = Tìm mọi loại tệp
dupes-skip-act-all-types-hint = Nếu bấm: lần tìm chạy lại với mọi loại tệp.
dupes-skip-act-again = Tìm lại
dupes-skip-act-again-hint = Nếu bấm: chạy lại đúng lần tìm này, không thay đổi gì.
dupes-start-title = Tìm các bản sao của cùng một tệp trong thư mục của bạn
dupes-start-body = Tìm trong Tài liệu, Tải xuống, Ảnh, Video, Nhạc và Màn hình nền những tệp có nội dung giống hệt nhau. Không có gì thay đổi cho đến khi bạn chọn bản cần xóa và xác nhận.
dupes-find-mine = Tìm tệp trùng trong các tệp của tôi
dupes-find-mine-again = Tìm lại trong các tệp của tôi
dupes-find-mine-hint = Nếu bấm: Tài liệu, Tải xuống, Ảnh, Video, Nhạc và Màn hình nền được đọc, không thay đổi gì. Tệp đám mây chỉ trực tuyến không bao giờ bị tải về.
dupes-choose = Chọn thư mục hoặc ổ đĩa
dupes-choose-hint = Nếu bấm: phần tùy chọn tìm kiếm mở ra để bạn chọn thư mục hoặc ổ cần tìm.
